#!/usr/bin/env python3
"""logscan -- query JSONL logs/transcripts in one call, bounded output for agents.

usage: logscan <file|dir|glob>... [--where key=value]... [--grep REGEX]
               [--fields a,b.c] [--count key] [--last N] [--width W]

Reads every *.jsonl / *.log line that parses as a JSON object (directories are
searched recursively). Keys may be dotted paths (message.role).

  --where k=v   keep records whose k equals v (string compare); repeatable
  --grep RE     keep records whose raw line matches RE
  --count k     print value counts of k among kept records (top 20)
  --fields a,b  print these fields for the last N kept records
  --last N      how many records to print (default 5)
  --width W     max chars per printed value (default 160)

Always prints a summary: files, lines, unparsable lines, kept records.
"""
import glob
import json
import os
import re
import sys
from collections import Counter


def die(msg):
    print("logscan: " + msg, file=sys.stderr)
    sys.exit(2)


def get(obj, path):
    for part in path.split("."):
        if isinstance(obj, dict) and part in obj:
            obj = obj[part]
        elif isinstance(obj, list) and part.isdigit() and int(part) < len(obj):
            obj = obj[int(part)]
        else:
            return None
    return obj


def text(value, width):
    s = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)
    s = s.replace("\n", "\\n")
    return s if len(s) <= width else s[: width - 1] + "…"


def expand(targets):
    files = []
    for t in targets:
        if os.path.isdir(t):
            for root, _, names in os.walk(t):
                files += [os.path.join(root, n) for n in names if n.endswith((".jsonl", ".log"))]
        elif os.path.isfile(t):
            files.append(t)
        else:
            files += [p for p in glob.glob(t, recursive=True) if os.path.isfile(p)]
    return sorted(set(files))


def main(argv):
    targets, where, fields, count, grep, last, width = [], [], [], None, None, 5, 160
    it = iter(argv)
    for a in it:
        try:
            if a == "--where":
                k, sep, v = next(it).partition("=")
                if not sep:
                    die("--where needs key=value")
                where.append((k, v))
            elif a == "--fields":
                fields = [f for f in next(it).split(",") if f]
            elif a == "--count":
                count = next(it)
            elif a == "--grep":
                grep = re.compile(next(it))
            elif a == "--last":
                last = int(next(it))
            elif a == "--width":
                width = int(next(it))
            elif a in ("-h", "--help"):
                print(__doc__.strip())
                return 0
            elif a.startswith("--"):
                die("unknown option " + a)
            else:
                targets.append(a)
        except StopIteration:
            die(a + " needs a value")
        except (ValueError, re.error) as e:
            die("bad value for %s: %s" % (a, e))
    if not targets:
        die("no input; try --help")
    files = expand(targets)
    if not files:
        die("no files matched")

    lines = bad = matched = 0
    kept = []
    counts = Counter()
    for path in files:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for raw in fh:
                if not raw.strip():
                    continue
                lines += 1
                try:
                    rec = json.loads(raw)
                except ValueError:
                    bad += 1
                    continue
                if not isinstance(rec, dict):
                    continue
                if grep and not grep.search(raw):
                    continue
                if any(text(get(rec, k), 10**9) != v for k, v in where):
                    continue
                matched += 1
                if count:
                    counts[text(get(rec, count), width)] += 1
                kept.append((path, rec))
                if len(kept) > max(last, 0):
                    kept.pop(0)
    print("## summary")
    print("files %d, lines %d, unparsable %d, kept %d" % (len(files), lines, bad, matched))
    if count:
        print("## count %s" % count)
        for value, n in counts.most_common(20):
            print("%7d  %s" % (n, value))
        if len(counts) > 20:
            print("        (+%d more values)" % (len(counts) - 20))
    if fields or not count:
        print("## last %d kept records" % len(kept))
        for path, rec in kept:
            shown = fields or list(rec.keys())[:6]
            parts = ["%s=%s" % (f, text(get(rec, f), width)) for f in shown]
            print("%s: %s" % (os.path.basename(path), "  ".join(parts)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
