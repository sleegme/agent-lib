s\\n' \"$files\" | while IFS= read -r f; do\n    [ -f \"$f\" ] && printf '%s\\n' \"$f\"\n  done)\nelse\n  files=$(find . -type f -name '*' ! -path './.git/*' | sed 's|^\\./||')\nfi\n\nif [ -n \"$glob\" ]; then\n  # shellcheck disable=SC2086\n  files=$(printf '%s\\n' \"$files\" | while IFS= read -r f; do\n    case \"$f\" in $glob) printf '%s\\n' \"$f\" ;; esac\n  done)\nfi\n\ntotal=0\nfailed=0\nfailmsg=\"\"\nerrtmp=$(mktemp)\ntrap 'rm -f \"$errtmp\"' EXIT\n\nwhile IFS= read -r f; do\n  [ -n \"$f\" ] || continue\n  total=$((total + 1))\n  # Token-wise {} substitution into an argv array: no eval, no quoting traps.\n  cmd=()\n  for arg in \"$@\"; do\n    if [ \"$arg\" = \"{}\" ]; then\n      cmd+=(\"$f\")\n    else\n      case \"$arg\" in\n        *'{}'*) cmd+=(\"${arg//\\{\\}/$f}\") ;;\n        *) cmd+=(\"$arg\") ;;\n      esac\n    fi\n  done\n  if ! \"${cmd[@]}\" >/dev/null 2>\"$errtmp\"; then\n    failed=$((failed + 1))\n    err=$(head -n 3 \"$errtmp\" | tr '\\n' ' ' | cut -c1-160)\n    failmsg=\"$failmsg$f: $err\\n\"\n  fi\ndone <<EOF\n$files\nEOF\n\nif [ \"$failed\" -gt 0 ]; then\n  printf '%b' \"$failmsg\"\n  echo \"failed $failed/$total\"\n  exit 1\nfi\necho \"ok $total/$total\"\nexit 0\n","exit":0,"truncated":false},"title":"ls -la; echo ---; find . -maxdepth 3 -name '*.py' | head -50; echo ---; cat [HOME]/work/agent-lib/bench/proto/foreach","time":{"start":1795417582142,"end":1795417582168}},"id":"prt_2073a28d4001Mvrd9PbX9NnJMT","sessionID":"ses_df8c61a6fffetwLpoPO4oNNd40","messageID":"msg_2073a2281001LaN7lzqFTk4ecQ"}}
