sues = 0;\nconst walk = (p) => {\n  const st = fs.statSync(p);\n  if (st.isDirectory()) { for (const e of fs.readdirSync(p).sort()) walk(path.join(p, e)); }\n  else if (p.endsWith('.js')) {\n    fs.readFileSync(p, 'utf8').split('\\n').forEach((line, i) => {\n      if (line.includes('console.log')) {\n        issues++;\n        console.log('Lint issue in ' + path.relative(process.cwd(), p));\n        console.log('  rule: no-console (line ' + (i + 1) + ')');\n      }\n    });\n  }\n};\nfor (const r of roots) walk(r);\nprocess.exit(issues ? 1 : 0);\n","exit":0,"truncated":false},"title":"for f in src/modules/alpha/index.js src/modules/alpha/alpha.test.js tools/lint.js; do echo \"=== $f ===\"; cat \"$f\"; done","time":{"start":1795417421066,"end":1795417421082}},"id":"prt_20737b3ba001bPwQjZJSEUXflL","sessionID":"ses_df8c86c3dffekRy5vi554UYKZD","messageID":"msg_20737ad26001snn7xsZjA1Ea5O"}}
