e,"loaded":[],"display":{"type":"file","path":"/tmp/issue1-runs/recipe__deepseek-v4.1-flash__TOOL_r3/tools/lint.js","text":"#!/usr/bin/env node\nconst fs = require('fs');\nconst path = require('path');\nconst roots = process.argv.slice(2).length ? process.argv.slice(2) : ['src'];\nlet issues = 0;\nconst walk = (p) => {\n  const st = fs.statSync(p);\n  if (st.isDirectory()) { for (const e of fs.readdirSync(p).sort()) walk(path.join(p, e)); }\n  else if (p.endsWith('.js')) {\n    fs.readFileSync(p, 'utf8').split('\\n').forEach((line, i) => {\n      if (line.includes('console.log')) {\n        issues++;\n        console.log('Lint issue in ' + path.relative(process.cwd(), p));\n        console.log('  rule: no-console (line ' + (i + 1) + ')');\n      }\n    });\n  }\n};\nfor (const r of roots) walk(r);\nprocess.exit(issues ? 1 : 0);","lineStart":1,"lineEnd":20,"totalLines":20,"truncated":false}},"title":"tools/lint.js","time":{"start":1795417442839,"end":1795417442845}},"id":"prt_207380905001joWZuBq2vWi6F4","sessionID":"ses_df8c834f0ffeRIvauUakB3bMGQ","messageID":"msg_20737fe3c001v555qjg3M3rvny"}}
