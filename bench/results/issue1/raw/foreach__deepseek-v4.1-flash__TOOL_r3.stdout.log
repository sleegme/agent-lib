{"type":"tool_use","timestamp":1795417103497,"sessionID":"ses_df8cd64f7ffe8xC5SWMZZsYoAE","part":{"type":"tool","tool":"bash","callID":"call_c0fc006f289943cdacf9e076","state":{"status":"completed","input":{"command":"cat [HOME]/work/agent-lib/bench/proto/foreach"},"output":"#!/usr/bin/env bash\n# foreach (issue #1 prototype) -- run one command per selected target file,\n# print only the failures. Selection: changed vs a git base ref and/or a glob.\n#\n# usage: foreach [--base REF] [--glob GLOB] [--] CMD...\n#   --base REF   select files that differ from REF (git diff --name-only REF)\n#   --glob G     shell glob applied to the selection (relative paths)\n#   CMD          command executed once per target; '{}' is replaced by the\n#                file path; without '{}' the path is appended.\n# Prints: one \"path: first error line\" line per failing target, then a\n# \"failed N/M\" summary. Exit 1 if any target failed, 0 otherwise, 2 usage.\nset -u\n\nusage() {\n  sed -n '2,9p' \"$0\" | sed 's/^# \\{0,1\\}//'\n  exit 2\n}\n\nbase=\"\"\nglob=\"\"\nwhile [ \"$#\" -gt 0 ]; do\n  case \"$1\" in\n    --base) [ $# -ge 2 ] || usage; base=\"$2\"; shift 2 ;;\n    --glob) [ $# -ge 2 ] || usage; glob=\"$2\"; shift 2 ;;\n    --) shift; break ;;\n    -h|--help) usage ;;\n    *) break ;;\n  esac\ndone\n[ $# -ge 1 ] || usage\n\nif [ -n \"$base\" ]; then\n  # Read-only git access; tolerate a missing ref with a clear error.\n  files=$(git diff --name-only \"$base\" -- 2>/dev/null) || {\n    echo \"foreach: git diff against '$base' failed\" >&2; exit 2; }\n  # Keep only files that still exist (deleted paths cannot be processed).\n  files=$(printf '%s\\n' \"$files\" | while IFS= read -r f; do\n    [ -f \"$f\" ] && printf '%s\\n' \"$f\"\n  done)\nelse\n  files=$(find . -type f -name '*' ! -path './.git/*' | sed 's|^\\./||')\nfi\n\nif [ -n \"$glob\" ]; then\n  # shellcheck disable=SC2086\n  files=$(printf '%s\\n' \"$files\" | while IFS= read -r f; do\n    case \"$f\" in $glob) printf '%s\\n' \"$f\" ;; esac\n  done)\nfi\n\ntotal=0\nfailed=0\nfailmsg=\"\"\nerrtmp=$(mktemp)\ntrap 'rm -f \"$errtmp\"' EXIT\n\nwhile IFS= read -r f; do\n  [ -n \"$f\" ] || continue\n  total=$((total + 1))\n  # Token-wise {} substitution into an argv array: no eval, no quoting traps.\n  cmd=()\n  for arg in \"$@\"; do\n    if [ \"$arg\" = \"{}\" ]; then\n      cmd+=(\"$f\")\n    else\n      case \"$arg\" in\n        *'{}'*) cmd+=(\"${arg//\\{\\}/$f}\") ;;\n        *) cmd+=(\"$arg\") ;;\n      esac\n    fi\n  done\n  if ! \"${cmd[@]}\" >/dev/null 2>\"$errtmp\"; then\n    failed=$((failed + 1))\n    err=$(head -n 3 \"$errtmp\" | tr '\\n' ' ' | cut -c1-160)\n    failmsg=\"$failmsg$f: $err\\n\"\n  fi\ndone <<EOF\n$files\nEOF\n\nif [ \"$failed\" -gt 0 ]; then\n  printf '%b' \"$failmsg\"\n  echo \"failed $failed/$total\"\n  exit 1\nfi\necho \"ok $total/$total\"\nexit 0\n","metadata":{"output":"#!/usr/bin/env bash\n# foreach (issue #1 prototype) -- run one command per selected target file,\n# print only the failures. Selection: changed vs a git base ref and/or a glob.\n#\n# usage: foreach [--base REF] [--glob GLOB] [--] CMD...\n#   --base REF   select files that differ from REF (git diff --name-only REF)\n#   --glob G     shell glob applied to the selection (relative paths)\n#   CMD          command executed once per target; '{}' is replaced by the\n#                file path; without '{}' the path is appended.\n# Prints: one \"path: first error line\" line per failing target, then a\n# \"failed N/M\" summary. Exit 1 if any target failed, 0 otherwise, 2 usage.\nset -u\n\nusage() {\n  sed -n '2,9p' \"$0\" | sed 's/^# \\{0,1\\}//'\n  exit 2\n}\n\nbase=\"\"\nglob=\"\"\nwhile [ \"$#\" -gt 0 ]; do\n  case \"$1\" in\n    --base) [ $# -ge 2 ] || usage; base=\"$2\"; shift 2 ;;\n    --glob) [ $# -ge 2 ] || usage; glob=\"$2\"; shift 2 ;;\n    --) shift; break ;;\n    -h|--help) usage ;;\n    *) break ;;\n  esac\ndone\n[ $# -ge 1 ] || usage\n\nif [ -n \"$base\" ]; then\n  # Read-only git access; tolerate a missing ref with a clear error.\n  files=$(git diff --name-only \"$base\" -- 2>/dev/null) || {\n    echo \"foreach: git diff against '$base' failed\" >&2; exit 2; }\n  # Keep only files that still exist (deleted paths cannot be processed).\n  files=$(printf '%s\\n' \"$files\" | while IFS= read -r f; do\n    [ -f \"$f\" ] && printf '%s\\n' \"$f\"\n  done)\nelse\n  files=$(find . -type f -name '*' ! -path './.git/*' | sed 's|^\\./||')\nfi\n\nif [ -n \"$glob\" ]; then\n  # shellcheck disable=SC2086\n  files=$(printf '%s\\n' \"$files\" | while IFS= read -r f; do\n    case \"$f\" in $glob) printf '%s\\n' \"$f\" ;; esac\n  done)\nfi\n\ntotal=0\nfailed=0\nfailmsg=\"\"\nerrtmp=$(mktemp)\ntrap 'rm -f \"$errtmp\"' EXIT\n\nwhile IFS= read -r f; do\n  [ -n \"$f\" ] || continue\n  total=$((total + 1))\n  # Token-wise {} substitution into an argv array: no eval, no quoting traps.\n  cmd=()\n  for arg in \"$@\"; do\n    if [ \"$arg\" = \"{}\" ]; then\n      cmd+=(\"$f\")\n    else\n      case \"$arg\" in\n        *'{}'*) cmd+=(\"${arg//\\{\\}/$f}\") ;;\n        *) cmd+=(\"$arg\") ;;\n      esac\n    fi\n  done\n  if ! \"${cmd[@]}\" >/dev/null 2>\"$errtmp\"; then\n    failed=$((failed + 1))\n    err=$(head -n 3 \"$errtmp\" | tr '\\n' ' ' | cut -c1-160)\n    failmsg=\"$failmsg$f: $err\\n\"\n  fi\ndone <<EOF\n$files\nEOF\n\nif [ \"$failed\" -gt 0 ]; then\n  printf '%b' \"$failmsg\"\n  echo \"failed $failed/$total\"\n  exit 1\nfi\necho \"ok $total/$total\"\nexit 0\n","exit":0,"truncated":false},"title":"cat [HOME]/work/agent-lib/bench/proto/foreach","time":{"start":1795417103438,"end":1795417103481}},"id":"prt_20732db79001qmBTr5Z1LFQLoO","sessionID":"ses_df8cd64f7ffe8xC5SWMZZsYoAE","messageID":"msg_20732d2d3001YqT7ffNhq1dI3G"}}
