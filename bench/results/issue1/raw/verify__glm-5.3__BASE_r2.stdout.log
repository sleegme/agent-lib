n    for (const e of fs.readdirSync(p).sort()) walk(path.join(p, e));\n  } else if (p.endsWith('.js')) {\n    const src = fs.readFileSync(p, 'utf8');\n    const lines = src.split('\\n');\n    lines.forEach((line, i) => {\n      if (line.includes('console.log')) {\n        issues++;\n        console.log('Lint issue in ' + path.relative(process.cwd(), p));\n        console.log('  rule: no-console (line ' + (i + 1) + ')');","truncated":false,"loaded":[],"display":{"type":"file","path":"/tmp/issue1-runs/verify__glm-5.3__BASE_r2/tools/lint.js","text":"#!/usr/bin/env node\n// usage: node tools/lint.js [paths...]  (default src)\n// Flags any .js file containing console.log. Prints one \"Lint issue in <file>\"\n// line per hit plus an indented rule line; exit 1 when any issue found.\nconst fs = require('fs');\nconst path = require('path');\nconst roots = process.argv.slice(2).length ? process.argv.slice(2) : ['src'];\nlet issues = 0;\nconst walk = (p) => {\n  const st = fs.statSync(p);\n  if (st.isDirectory()) {\n    for (const e of fs.readdirSync(p).sort()) walk(path.join(p, e));\n  } else if (p.endsWith('.js')) {\n    const src = fs.readFileSync(p, 'utf8');\n    const lines = src.split('\\n');\n    lines.forEach((line, i) => {\n      if (line.includes('console.log')) {\n        issues++;\n        console.log('Lint issue in ' + path.relative(process.cwd(), p));\n        console.log('  rule: no-console (line ' + (i + 1) + ')');\n      }\n    });\n  }\n};\nfor (const r of roots) walk(r);\nprocess.exit(issues ? 1 : 0);","lineStart":1,"lineEnd":26,"totalLines":26,"truncated":false}},"title":"tmp/issue1-runs/verify__glm-5.3__BASE_r2/tools/lint.js","time":{"start":1795416953821,"end":1795416953829}},"id":"prt_2073093d9001BwZmH0N4C3WUU4","sessionID":"ses_df8cf7e7affe33mcGEzN5TImPh","messageID":"msg_207309041001FW8JGmJ4Iri40Q"}}
