  files=$(find . -type f -name '*' ! -path './.git/*' | sed 's|^\\./||')\n42: fi\n43: \n44: if [ -n \"$glob\" ]; then\n45:   # shellcheck disable=SC2086\n46:   files=$(printf '%s\\n' \"$files\" | while IFS= read -r f; do\n47:     case \"$f\" in $glob) printf '%s\\n' \"$f\" ;; esac\n48:   done)\n49: fi\n50: \n51: total=0\n52: failed=0\n53: failmsg=\"\"\n54: errtmp=$(mktemp)\n55: trap 'rm -f \"$errtmp\"' EXIT\n56: \n57: while IFS= read -r f; do\n58:   [ -n \"$f\" ] || continue\n59:   total=$((total + 1))\n60:   # Token-wise {} substitution into an argv array: no eval, no quoting traps.\n61:   cmd=()\n62:   for arg in \"$@\"; do\n63:     if [ \"$arg\" = \"{}\" ]; then\n64:       cmd+=(\"$f\")\n65:     else\n66:       case \"$arg\" in\n67:         *'{}'*) cmd+=(\"${arg//\\{\\}/$f}\") ;;\n68:         *) cmd+=(\"$arg\") ;;\n69:       esac\n70:     fi\n71:   done\n72:   if ! \"${cmd[@]}\" >/dev/null 2>\"$errtmp\"; then\n73:     failed=$((failed + 1))\n74:     err=$(head -n 3 \"$errtmp\" | tr '\\n' ' ' | cut -c1-160)\n75:     failmsg=\"$failmsg$f: $err\\n\"\n76:   fi\n77: done <<EOF\n78: $files\n79: EOF\n80: \n81: if [ \"$failed\" -gt 0 ]; then\n82:   printf '%b' \"$failmsg\"\n83:   echo \"failed $failed/$total\"\n84:   exit 1\n85: fi\n86: echo \"ok $total/$total\"\n87: exit 0\n\n(End of file - total 87 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env bash\n# foreach (issue #1 prototype) -- run one command per selected target file,\n# print only the failures. Selection: changed vs a git base ref and/or a glob.\n#\n# usage: foreach [--base REF] [--glob GLOB] [--] CMD...\n#   --base REF   select files that differ from REF (git diff --name-only REF)\n#   --glob G     shell glob applied to the selection (relative paths)\n#   CMD          command executed once per target; '{}' is replaced by the\n#                file path; without '{}' the path is appended.\n# Prints: one \"path: first error line\" line per failing target, then a\n# \"failed N/M\" summary. Exit 1 if any target failed, 0 otherwise, 2 usage.\nset -u\n\nusage() {\n  sed -n '2,9p' \"$0\" | sed 's/^# \\{0,1\\}//'\n  exit 2\n}\n\nbase=\"\"\nglob=\"\"","truncated":false,"loaded":[],"display":{"type":"file","path":"[HOME]/work/agent-lib/bench/proto/foreach","text":"#!/usr/bin/env bash\n# foreach (issue #1 prototype) -- run one command per selected target file,\n# print only the failures. Selection: changed vs a git base ref and/or a glob.\n#\n# usage: foreach [--base REF] [--glob GLOB] [--] CMD...\n#   --base REF   select files that differ from REF (git diff --name-only REF)\n#   --glob G     shell glob applied to the selection (relative paths)\n#   CMD          command executed once per target; '{}' is replaced by the\n#                file path; without '{}' the path is appended.\n# Prints: one \"path: first error line\" line per failing target, then a\n# \"failed N/M\" summary. Exit 1 if any target failed, 0 otherwise, 2 usage.\nset -u\n\nusage() {\n  sed -n '2,9p' \"$0\" | sed 's/^# \\{0,1\\}//'\n  exit 2\n}\n\nbase=\"\"\nglob=\"\"\nwhile [ \"$#\" -gt 0 ]; do\n  case \"$1\" in\n    --base) [ $# -ge 2 ] || usage; base=\"$2\"; shift 2 ;;\n    --glob) [ $# -ge 2 ] || usage; glob=\"$2\"; shift 2 ;;\n    --) shift; break ;;\n    -h|--help) usage ;;\n    *) break ;;\n  esac\ndone\n[ $# -ge 1 ] || usage\n\nif [ -n \"$base\" ]; then\n  # Read-only git access; tolerate a missing ref with a clear error.\n  files=$(git diff --name-only \"$base\" -- 2>/dev/null) || {\n    echo \"foreach: git diff against '$base' failed\" >&2; exit 2; }\n  # Keep only files that still exist (deleted paths cannot be processed).\n  files=$(printf '%s\\n' \"$files\" | while IFS= read -r f; do\n    [ -f \"$f\" ] && printf '%s\\n' \"$f\"\n  done)\nelse\n  files=$(find . -type f -name '*' ! -path './.git/*' | sed 's|^\\./||')\nfi\n\nif [ -n \"$glob\" ]; then\n  # shellcheck disable=SC2086\n  files=$(printf '%s\\n' \"$files\" | while IFS= read -r f; do\n    case \"$f\" in $glob) printf '%s\\n' \"$f\" ;; esac\n  done)\nfi\n\ntotal=0\nfailed=0\nfailmsg=\"\"\nerrtmp=$(mktemp)\ntrap 'rm -f \"$errtmp\"' EXIT\n\nwhile IFS= read -r f; do\n  [ -n \"$f\" ] || continue\n  total=$((total + 1))\n  # Token-wise {} substitution into an argv array: no eval, no quoting traps.\n  cmd=()\n  for arg in \"$@\"; do\n    if [ \"$arg\" = \"{}\" ]; then\n      cmd+=(\"$f\")\n    else\n      case \"$arg\" in\n        *'{}'*) cmd+=(\"${arg//\\{\\}/$f}\") ;;\n        *) cmd+=(\"$arg\") ;;\n      esac\n    fi\n  done\n  if ! \"${cmd[@]}\" >/dev/null 2>\"$errtmp\"; then\n    failed=$((failed + 1))\n    err=$(head -n 3 \"$errtmp\" | tr '\\n' ' ' | cut -c1-160)\n    failmsg=\"$failmsg$f: $err\\n\"\n  fi\ndone <<EOF\n$files\nEOF\n\nif [ \"$failed\" -gt 0 ]; then\n  printf '%b' \"$failmsg\"\n  echo \"failed $failed/$total\"\n  exit 1\nfi\necho \"ok $total/$total\"\nexit 0","lineStart":1,"lineEnd":87,"totalLines":87,"truncated":false}},"title":"../../..[HOME]/work/agent-lib/bench/proto/foreach","time":{"start":1795416211291,"end":1795416211302}},"id":"prt_207253f54001E3TjjvwZP7Ktdh","sessionID":"ses_df8dafd3dffeAUghSDwC9RnQM7","messageID":"msg_207253c47001UkCQOPLNq1Gw8U"}}
